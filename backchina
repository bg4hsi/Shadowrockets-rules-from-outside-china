[Rule]

# 强制放行本地局域网、组播和广播 (拯救本地智能家居和 NAS 发现机制)
IP-CIDR,192.168.0.0/16,DIRECT
IP-CIDR,10.0.0.0/8,DIRECT
IP-CIDR,172.16.0.0/12,DIRECT
IP-CIDR,224.0.0.0/4,DIRECT
IP-CIDR,255.255.255.255/32,DIRECT

# 全局拦截所有网页端 QUIC (UDP 443)，强迫所有 App 图片/视频使用 TCP 走极速通道
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

# 拦截微信图片的 UDP，强迫走 TCP (享受 BBRplus 加速，解决发照片卡死)
AND,((PROTOCOL,UDP),(DOMAIN-SUFFIX,qpic.cn)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DOMAIN-SUFFIX,servicewechat.com)),REJECT-NO-DROP

# 拦截朋友圈和视频号的 UDP，强迫走 TCP 享受 BBRplus 加速
AND,((PROTOCOL,UDP),(DOMAIN-SUFFIX,tc.qq.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DOMAIN-KEYWORD,video.qq.com)),REJECT-NO-DROP

# 放行微信核心信令域名，解决发文字转圈问题 (绕过 Hysteria 节点直接发往国内)
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,wechat.com,DIRECT

# 拯救同花顺，金融行情与交易接口强行直连回国 (避免被风控拦截和超时死链)
DOMAIN-SUFFIX,10jqka.com.cn,DIRECT
DOMAIN-SUFFIX,hexin.cn,DIRECT
DOMAIN-SUFFIX,ths.com.cn,DIRECT
DOMAIN-SUFFIX,iwencai.com,DIRECT
DOMAIN-KEYWORD,10jqka,DIRECT
DOMAIN-KEYWORD,hexin,DIRECT

# 放行部分智能硬件常用的底层 P2P 穿透域名 (TUTK)
DOMAIN-SUFFIX,tutk.com,DIRECT

